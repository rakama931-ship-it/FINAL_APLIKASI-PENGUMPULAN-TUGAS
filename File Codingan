def rounded_bg(widget, color=WHITE, radius=16):
    with widget.canvas.before:
        Color(*color)
        widget._bg = RoundedRectangle(
            pos=widget.pos,
            size=widget.size,
            radius=[dp(radius)]
        )
    widget.bind(
        pos=lambda w, v: setattr(w._bg, "pos", v),
        size=lambda w, v: setattr(w._bg, "size", v),
    )


def page_bg(widget):
    with widget.canvas.before:
        Color(*BG)
        widget._page_bg = RoundedRectangle(
            pos=widget.pos,
            size=widget.size,
            radius=[0]
        )
    widget.bind(
        pos=lambda w, v: setattr(w._page_bg, "pos", v),
        size=lambda w, v: setattr(w._page_bg, "size", v),
    )


def button(text, color=BLUE, height=52, font_size=14):
    b = Button(
        text=text,
        size_hint_y=None,
        height=dp(height),
        background_normal="",
        background_color=color,
        color=WHITE,
        font_size=f"{font_size}sp",
        bold=True,
    )
    return b


def label(text="", size=14, color=TEXT, bold=False, halign="left"):
    return Label(
        text=text,
        color=color,
        font_size=f"{size}sp",
        bold=bold,
        halign=halign,
        valign="middle",
    )


def card(color=WHITE, height=None, padding=14, spacing=8):
    box = BoxLayout(
        orientation="vertical",
        padding=dp(padding),
        spacing=dp(spacing),
        size_hint_y=None if height else 1,
    )
    if height:
        box.height = dp(height)
    rounded_bg(box, color)
    return box


# ============================================================
# DATABASE
# ============================================================
class Database:
    def __init__(self):
        self.connection = sqlite3.connect("portal_belajar.db")
        self.create_tables()

    def create_tables(self):
        self.connection.execute("""
            CREATE TABLE IF NOT EXISTS tugas (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                nama_siswa TEXT NOT NULL,
                repository TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'Terkirim',
                nilai INTEGER DEFAULT NULL,
                judul_tugas TEXT DEFAULT 'Tugas',
                komentar TEXT DEFAULT ''
            )
        """)

        columns = {
            row[1] for row in
            self.connection.execute("PRAGMA table_info(tugas)").fetchall()
        }

        if "judul_tugas" not in columns:
            self.connection.execute(
                "ALTER TABLE tugas ADD COLUMN judul_tugas TEXT DEFAULT 'Tugas'"
            )

        if "komentar" not in columns:
            self.connection.execute(
                "ALTER TABLE tugas ADD COLUMN komentar TEXT DEFAULT ''"
            )

        self.connection.commit()

    def add_task(self, name, repository, title="Tugas"):
        cur = self.connection.execute(
            """INSERT INTO tugas
               (nama_siswa, repository, status, judul_tugas, komentar)
               VALUES (?, ?, 'Terkirim', ?, '')""",
            (name, repository, title),
        )
        self.connection.commit()
        return cur.lastrowid

    def get_all_tasks(self):
        return self.connection.execute(
            """SELECT id, nama_siswa, repository, status, nilai,
                      judul_tugas, komentar
               FROM tugas ORDER BY id DESC"""
        ).fetchall()

    def get_task(self, task_id):
        return self.connection.execute(
            """SELECT id, nama_siswa, repository, status, nilai,
                      judul_tugas, komentar
               FROM tugas WHERE id=?""",
            (task_id,),
        ).fetchone()

    def get_student_tasks(self, name):
        return self.connection.execute(
            """SELECT id, nama_siswa, repository, status, nilai,
                      judul_tugas, komentar
               FROM tugas WHERE nama_siswa=? ORDER BY id DESC""",
            (name,),
        ).fetchall()

    def update_score(self, task_id, score, comment):
        self.connection.execute(
            """UPDATE tugas
               SET nilai=?, status='Dinilai', komentar=?
               WHERE id=?""",
            (score, comment, task_id),
        )
        self.connection.commit()

    def statistics(self):
        total = self.connection.execute(
            "SELECT COUNT(*) FROM tugas"
        ).fetchone()[0]

        graded = self.connection.execute(
            "SELECT COUNT(*) FROM tugas WHERE nilai IS NOT NULL"
        ).fetchone()[0]

        average = self.connection.execute(
            "SELECT AVG(nilai) FROM tugas WHERE nilai IS NOT NULL"
        ).fetchone()[0]

        return total, graded, average

    def close(self):
        self.connection.close()


