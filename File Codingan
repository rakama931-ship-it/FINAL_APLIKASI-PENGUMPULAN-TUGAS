class StudentHistoryScreen(BaseScreen):
    def __init__(self, **kwargs):
        super().__init__(**kwargs)

        root = BoxLayout(orientation="vertical")
        page_bg(root)

        header = BoxLayout(
            size_hint_y=None,
            height=dp(65),
            padding=dp(8)
        )
        back = button("‹", BLUE_DARK, 48, 22)
        back.size_hint_x = None
        back.width = dp(52)
        back.bind(
            on_press=lambda *_: self.go("student_dashboard", "right")
        )
        header.add_widget(back)
        header.add_widget(label("Riwayat & Nilai", 19, WHITE, True, "center"))
        root.add_widget(header)

        scroll = ScrollView()
        self.container = BoxLayout(
            orientation="vertical",
            spacing=dp(10),
            padding=dp(15),
            size_hint_y=None
        )
        self.container.bind(
            minimum_height=self.container.setter("height")
        )
        scroll.add_widget(self.container)
        root.add_widget(scroll)

        self.add_widget(root)

    def on_pre_enter(self, *args):
        self.load_history()

    def load_history(self):
        self.container.clear_widgets()
        name = self.manager.student_name or "Siswa"
        tasks = self.manager.database.get_student_tasks(name)

        if not tasks:
            self.container.add_widget(label(
                "Belum ada tugas yang dikumpulkan.",
                14, GRAY, False, "center"
            ))
            return

        for task in tasks:
            task_id, student, repo, status, score, title, comment = task

            c = card(WHITE, 190, 13, 6)
            c.add_widget(label(title or "Tugas", 16, TEXT, True))
            c.add_widget(label(f"Status: {status}", 12, BLUE, True))

            score_text = (
                str(score) if score is not None else "Belum dinilai"
            )
            c.add_widget(label(
                f"Nilai: {score_text}",
                14,
                GREEN if score is not None else ORANGE,
                True
            ))

            c.add_widget(label(
                f"Komentar guru: {comment or '-'}",
                12, GRAY
            ))
            c.add_widget(label(repo, 10, BLUE))
            self.container.add_widget(c)


