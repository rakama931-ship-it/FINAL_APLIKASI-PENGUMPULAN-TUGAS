        name = self.manager.student_name or "Siswa"
        self.welcome.text = f"Halo, {name} 👋"
        self.summary.clear_widgets()

        rows = self.manager.database.get_student_tasks(name)
        total = len(rows)
        graded = sum(1 for r in rows if r[4] is not None)
        waiting = total - graded

        for icon, title, value, color in [
            ("📚", "Terkirim", total, BLUE),
            ("✓", "Dinilai", graded, GREEN),
            ("⏳", "Menunggu", waiting, ORANGE),
        ]:
            c = card(WHITE, 92, 8, 2)
            c.add_widget(label(icon, 22, color, True, "center"))
            c.add_widget(label(str(value), 20, TEXT, True, "center"))
            c.add_widget(label(title, 10, GRAY, False, "center"))
            self.summary.add_widget(c)

    def on_pre_enter(self, *args):
        self.refresh()

    def logout(self, *_):
        self.manager.user_role = None
        self.manager.student_name = ""
        self.go("login", "right")


